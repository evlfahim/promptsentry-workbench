{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2022",
    "composite": true,
    "incremental": true
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../core" }]
}
