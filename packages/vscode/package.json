{
  "name": "@sentry-prompt/vscode",
  "displayName": "PromptSentry Workbench",
  "description": "Local-first prompt workbench with git-style versioning and execution against OpenAI-compatible endpoints",
  "version": "0.1.0",
  "publisher": "sentry-prompt",
  "author": "Sentry",
  "repository": {
    "type": "git",
    "url": "https://github.com/sentry-prompt/promptsentry-workbench"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "icon": "resources/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "prompt",
    "llm",
    "openai",
    "ollama",
    "workbench"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "promptsentry.refresh",
        "title": "PromptSentry: Refresh Prompts",
        "icon": "$(refresh)"
      },
      {
        "command": "promptsentry.newPrompt",
        "title": "PromptSentry: New Prompt",
        "icon": "$(add)"
      },
      {
        "command": "promptsentry.runPrompt",
        "title": "PromptSentry: Run Prompt",
        "icon": "$(play)"
      },
      {
        "command": "promptsentry.compare",
        "title": "PromptSentry: Compare Versions",
        "icon": "$(diff)"
      },
      {
        "command": "promptsentry.openPanel",
        "title": "PromptSentry: Open Workbench",
        "icon": "$(output)"
      },
      {
        "command": "promptsentry.openApiConfig",
        "title": "PromptSentry: Configure API",
        "icon": "$(gear)"
      },
      {
        "command": "promptsentry.startWatching",
        "title": "PromptSentry: Start File Watching",
        "icon": "$(folder-library)"
      },
      {
        "command": "promptsentry.stopWatching",
        "title": "PromptSentry: Stop File Watching",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "promptsentry.watchingStatus",
        "title": "PromptSentry: File Watching Status",
        "icon": "$(info)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "promptsentryView",
          "name": "PromptSentry",
          "icon": "$(heart)",
          "contextualTitle": "PromptSentry Workbench"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "promptsentryView",
        "contents": "No prompts yet.\n[Create a Prompt](command:promptsentry.newPrompt)\n[Open Workbench](command:promptsentry.openPanel)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "promptsentry.refresh"
        },
        {
          "command": "promptsentry.newPrompt"
        },
        {
          "command": "promptsentry.runPrompt"
        },
        {
          "command": "promptsentry.compare"
        },
        {
          "command": "promptsentry.openPanel"
        },
        {
          "command": "promptsentry.openApiConfig"
        },
        {
          "command": "promptsentry.startWatching"
        },
        {
          "command": "promptsentry.stopWatching"
        },
        {
          "command": "promptsentry.watchingStatus"
        }
      ],
      "view/title": [
        {
          "command": "promptsentry.refresh",
          "when": "view == promptsentryView",
          "group": "navigation"
        },
        {
          "command": "promptsentry.newPrompt",
          "when": "view == promptsentryView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "PromptSentry",
      "properties": {
        "promptsentry.apiBaseUrl": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "description": "Base URL for the OpenAI-compatible API endpoint (e.g., Ollama, vLLM)"
        },
        "promptsentry.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the OpenAI-compatible endpoint (leave empty for local models)"
        },
        "promptsentry.defaultModel": {
          "type": "string",
          "default": "llama3",
          "description": "Default model to use for prompt execution"
        },
        "promptsentry.watchDirectory": {
          "type": "string",
          "default": "",
          "description": "Directory to watch for .prompt files. When set, the extension automatically syncs file changes to the database."
        },
        "promptsentry.autoCreatePrompts": {
          "type": "boolean",
          "default": true,
          "description": "Automatically create prompts when new .prompt files are detected in the watched directory."
        },
        "promptsentry.autoUpdateVersions": {
          "type": "boolean",
          "default": true,
          "description": "Automatically create new versions when .prompt files change in the watched directory."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "tsc -p ./ --noEmit && node esbuild.cjs",
    "build": "tsc && node esbuild.cjs",
    "lint": "eslint src/",
    "test": "node --experimental-vm-modules ../../node_modules/.bin/jest --config jest.config.js",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "glob": "^11.0.0",
    "jest": "^29.7.0",
    "minimatch": "^10.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.0",
    "esbuild": "^0.24.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0"
  },
  "dependencies": {
    "@sentry-prompt/core": "*"
  }
}
